# ~/.zshenv - Environment variables for ALL shells (including non-interactive)
# This file is sourced first, before .zshrc
# Only put truly global environment variables here

# Editor
export EDITOR='vim'

# Locale (uncomment if needed)
# export LANG=en_US.UTF-8
# export LC_ALL=en_US.UTF-8

# Claude Code
export CLAUDE_CODE_VERSION_OVERRIDE=latest

# Cargo/Rust
[[ -f "$HOME/.cargo/env"  ]] && . "$HOME/.cargo/env"
export VAULT_ADDR=https://vault.viktorbarzin.me

# agent-paste: keep its ssh() wrapper out of Claude Code shells. Claude's
# shell snapshot drops the _agent_paste_* helper the wrapper calls, so bare
# `ssh` fails there. The hook skips itself when this is already set.
if [[ -n "${CLAUDECODE:-}" ]]; then
  AGENT_PASTE_SHELL_HOOK_LOADED=local-v1
fi
