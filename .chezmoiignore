# The devvm runs a divergent, secret-bearing ~/.claude/settings.json (homelab
# plugins + MEMORY_API_KEY at mode 0600, added out-of-band — NOT in this repo).
# chezmoi must not manage or clobber it there (a `chezmoi apply` would revert the
# 0600 and overwrite the homelab config). Other machines keep it chezmoi-managed.
{{ if eq .chezmoi.hostname "devvm" }}
.claude/settings.json
# The devvm provisioner installs these org hooks from infra's
# scripts/workstation/claude-hooks and keeps them current; the copies here are
# older ones kept for other machines' settings.json, and the last four are hooks
# from the retired memory MCP. A whole-tree apply must not write any of them.
.claude/hooks/auto-learn.py
.claude/hooks/post-compact-recovery.sh
.claude/hooks/pre-compact-backup.sh
.claude/hooks/unslop-check.py
.claude/hooks/auto-allow-memory-tools.py
.claude/hooks/memory-sync.py
.claude/hooks/post-commit-memory.py
.claude/hooks/user-prompt-recall.py
{{ end }}

# Agent files (2026-09-22; ~/.agents since 2026-09-25). chezmoi manages
# ~/.agents from dot_agents/ like any other dotfile, and agents-sync saves edits
# made there back here. These are made on the machine and never belong in the
# repo: the joined AGENTS.md, agents-sync's backups, and the lockfile of the
# upstream skills the skills updater installs beside Viktor's own.
.agents/AGENTS.md
.agents/backup
.agents/backup/**
.agents/.skill-lock.json

# macOS is a work machine: its ~/.claude/CLAUDE.md and ~/.codex/AGENTS.md are
# employer files, and a symlink entry replaces an existing file or directory
# without asking. Keep every agent entry off it until it joins with the work
# profile through an import.
{{ if eq .chezmoi.os "darwin" }}
.agents/**
.claude/CLAUDE.md
.codex/AGENTS.md
.pi/agent/AGENTS.md
.claude/skills/**
.config/systemd/**
{{ end }}
