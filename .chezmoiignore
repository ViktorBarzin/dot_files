# The devvm and its rebuild drills (hosts named devvm*) keep every file under
# ~/.claude in the claude-sessions store, which restores them on a rebuild, and
# the infra provisioner installs the org hooks and fills the secrets in
# settings.json. The copies here are other machines' (settings.json with Mac
# paths, the memory MCP the devvm retired on 2026-06-20 and its hooks, old
# plugin lists and caches). chezmoi writing them first made the store's
# restore keep the stale copy, which the ingest then stored as the newest
# (rebuild drill, 2026-11-11). So on the devvm chezmoi keeps only the links:
# CLAUDE.md and the skill links. ~/.codex holds links alone already.
# The memory MCP's other two pieces stay off it too, and so does the old
# vault-token-renew.sh: the provisioner installs ~/.local/bin/vault-token-renew.
{{ if hasPrefix "devvm" .chezmoi.hostname }}
.claude/**
!.claude/CLAUDE.md
!.claude/skills
!.claude/skills/**
.mcp.json
.local/bin/claude-memory-mcp-wrapper
.local/bin/vault-token-renew.sh
{{ end }}

# Agent files (2026-09-22; ~/.agents since 2026-09-25). chezmoi manages
# ~/.agents from dot_agents/ like any other dotfile, and agents-sync saves what
# changes there back here: edits, new files and deletions (2026-10-04). These
# are made on the machine and never belong in the repo: agents-sync's backups
# and the lockfile of the upstream skills the skills updater installs beside
# Viktor's own. AGENTS.md itself is edited in ~/.agents and saved like any other
# file since 2026-11-09 (it was built from core.md + personal.md before).
.agents/backup
.agents/backup/**
.agents/.skill-lock.json
# The upstream skills themselves, named in that lockfile: they are referenced
# and kept current by the updater, never copied here. Caches and editor
# leftovers stay out too.
{{ $lock := joinPath .chezmoi.homeDir ".agents/.skill-lock.json" -}}
{{ if stat $lock -}}
{{   range $name, $_ := (include $lock | fromJson).skills -}}
.agents/skills/{{ $name }}
.agents/skills/{{ $name }}/**
{{   end -}}
{{ end -}}
.agents/**/__pycache__
.agents/**/__pycache__/**
.agents/**/*.pyc
.agents/**/.DS_Store
.agents/**/*.swp
.agents/**/*~

# macOS is a work machine: its ~/.claude/CLAUDE.md and ~/.codex/AGENTS.md are
# employer files, and a symlink entry replaces an existing file or directory
# without asking. Keep every agent entry off it until it joins with the work
# profile through an import.
{{ if eq .chezmoi.os "darwin" }}
.agents/**
.claude/CLAUDE.md
.codex/AGENTS.md
.pi/agent/AGENTS.md
.claude/skills/**
.config/systemd/**
{{ end }}

# The devvm is rebuilt from code (2026-11-11). Its two GPG-encrypted files, the
# admin kubeconfig and the zsh secrets, come from its credential restore there,
# so chezmoi neither asks for the passphrase nor overwrites them. The local
# terminal-lobby UI exists only on that box.
{{ if hasPrefix "devvm" .chezmoi.hostname }}
.kube/config
.oh-my-zsh/custom/secrets.zsh
{{ else }}
.config/systemd/user/lobby-local.service
.config/systemd/user/default.target.wants/lobby-local.service
{{ end }}

# The Mac's LaunchAgents and its london-probe sources belong to the Mac alone.
{{ if ne .chezmoi.os "darwin" }}
Library
Library/**
mac
mac/**
{{ end }}
